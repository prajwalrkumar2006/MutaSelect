# MutaSelect AI Configuration

# Backend Cloud Run Worker URL
# In production, set to your deployed Google Cloud Run service URL
VITE_BACKEND_URL="https://mutaselect-worker-xyz-uc.a.run.app"

# Firebase Client SDK Configuration (Populated via Firebase Console)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="mutaselect-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="mutaselect-ai"
VITE_FIREBASE_STORAGE_BUCKET="mutaselect-ai.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# App URL
APP_URL="http://localhost:3000"
